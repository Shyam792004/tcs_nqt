//both subarray with maximum value
class Solution {
    public int maxSubArray(int[] nums) {
        int n=nums.length;
        int sum=0;
        int max=Integer.MIN_VALUE;
        int start=0;
        int end=0;
        for(int i=0;i<n;i++)
        {
            sum+=nums[i];
            if(sum==0)
            {
                start=i;
            }
            if(sum>max)
            {
                max=sum;
                end=i;
            }
            if(sum<0)
            {
                sum=0;
            }
        }
        //subarray also
        for(int i=start;i<=end;i++)
        {
            System.out.print(nums[i]+" ");
        }
        return max;
    }
}
