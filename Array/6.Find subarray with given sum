class Solution {
    public int subarraySum(int[] nums, int k) {
        int prefixSum=0;
        int cnt=0;
        HashMap<Integer,Integer> mp=new HashMap<>();
        mp.put(0,1);

        for(int i:nums)
        {
            prefixSum+=i;

            if(mp.containsKey(prefixSum-k))
            {
                cnt+=mp.get(prefixSum-k);
            }
            mp.put(prefixSum,mp.getOrDefault(prefixSum,0)+1);
        }
        return cnt;
    }
}
